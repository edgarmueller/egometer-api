# Copy to .env to override the local defaults from .env.development, or as a
# starting point for the environment of a deployed instance (NODE_ENV=production
# skips .env.development, so MONGODB_URI and JWT_SECRET must be set there).

# Port the API listens on
# PORT=3000

# MongoDB connection string
# MONGODB_URI=mongodb://localhost:27017/egometer

# Secret used to sign login tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# How long a login stays valid (e.g. 12h, 7d, 30d). Defaults to 7d.
# JWT_EXPIRES_IN=7d

# Set to false to disable creating new accounts (e.g. once you've created yours)
# ALLOW_SIGNUP=true
