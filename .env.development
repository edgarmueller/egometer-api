# Defaults for local development, loaded unless NODE_ENV=production.
# Values in .env or the environment take precedence; see .env.example.

PORT=3000

# MongoDB from `npm run infra:up`
MONGODB_URI=mongodb://localhost:27017/egometer

# Development only: anyone who knows this secret can sign valid login tokens,
# so never use it for a deployed instance.
JWT_SECRET=local-dev-secret-not-for-production-0123456789
JWT_EXPIRES_IN=7d

ALLOW_SIGNUP=true
